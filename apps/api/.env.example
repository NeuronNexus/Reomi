NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Supabase > Connect > Session pooler. The direct connection is IPv6 only.
DATABASE_URL=postgres://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10

SUPABASE_URL=https://YOUR_REF.supabase.co
# Only for projects still on the legacy shared secret. Leave unset to verify through JWKS.
# SUPABASE_JWT_SECRET=

# Comma separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# "mock" is refused when NODE_ENV=production.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# How long an accepted applicant holds a seat before it is released.
PAYMENT_WINDOW_HOURS=48
RATE_LIMIT_MAX=300
