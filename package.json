{
  "name": "reomi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:local": "tsx tools/local-stack/index.ts",
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./apps/* build",
    "test": "pnpm --filter @reomi/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @reomi/api db:generate",
    "db:migrate": "pnpm --filter @reomi/api db:migrate",
    "db:seed": "pnpm --filter @reomi/api db:seed",
    "admin:grant": "pnpm --filter @reomi/api admin:grant",
    "demo:seed": "pnpm --filter @reomi/seed-demo exec tsx index.ts",
    "demo:reset": "pnpm --filter @reomi/seed-demo exec tsx index.ts reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
